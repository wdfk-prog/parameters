/* Host-test parameter table with one persistent scalar slot removed. */
PAR_ITEM_U8     (ePAR_TEST_MODE       , 1U , "Mode"       , 0U       , 10U        , 1U                                                                                         , NULL   , ePAR_ACCESS_RW, ePAR_ROLE_ALL, ePAR_ROLE_ALL , 0, "Former persistent U8 test value")
PAR_ITEM_I8     (ePAR_TEST_I8         , 2U , "Signed 8"   , -10      , 10         , -1                                                                                         , NULL   , ePAR_ACCESS_RW, ePAR_ROLE_ALL, ePAR_ROLE_ALL , 0, "I8 test value")
PAR_ITEM_U16    (ePAR_TEST_U16        , 3U , "Unsigned 16", 0U       , 1000U      , 100U                                                                                        , NULL   , ePAR_ACCESS_RW, ePAR_ROLE_ALL, ePAR_ROLE_ALL , 1, "Persistent U16 test value")
PAR_ITEM_I16    (ePAR_TEST_I16        , 4U , "Signed 16"  , -100     , 100        , -10                                                                                         , NULL   , ePAR_ACCESS_RW, ePAR_ROLE_ALL, ePAR_ROLE_ALL , 0, "I16 test value")
PAR_ITEM_U32    (ePAR_TEST_U32        , 5U , "Unsigned 32", 0UL      , 100000UL   , 1000UL                                                                                      , NULL   , ePAR_ACCESS_RW, ePAR_ROLE_ALL, ePAR_ROLE_ALL , 1, "Persistent U32 test value")
PAR_ITEM_I32    (ePAR_TEST_I32        , 6U , "Signed 32"  , -100000L , 100000L    , -1000L                                                                                      , NULL   , ePAR_ACCESS_RW, ePAR_ROLE_ALL, ePAR_ROLE_ALL , 0, "I32 test value")
PAR_ITEM_F32    (ePAR_TEST_F32        , 7U , "Float"      , -10.0f   , 10.0f      , 1.5f                                                                                        , "V"    , ePAR_ACCESS_RW, ePAR_ROLE_ALL, ePAR_ROLE_ALL , 0, "F32 test value")
PAR_ITEM_U8     (ePAR_TEST_RO         , 8U , "Read Only"  , 0U       , 5U         , 2U                                                                                          , NULL   , ePAR_ACCESS_RO, ePAR_ROLE_ALL, ePAR_ROLE_NONE, 0, "Read-only scalar")
PAR_ITEM_STR    (ePAR_TEST_STR        , 9U , "Name"       , 0U       , 8U         , ((par_obj_init_t){ .p_data = (const uint8_t *)"ap", .len = 2U })                            , NULL   , ePAR_ACCESS_RW, ePAR_ROLE_ALL, ePAR_ROLE_ALL , 1, "Persistent string object")
PAR_ITEM_BYTES  (ePAR_TEST_BYTES      , 10U , "Key"        , 0U       , 4U         , ((par_obj_init_t){ .p_data = (const uint8_t[]){ 0x01U, 0x02U }, .len = 2U })                 , NULL   , ePAR_ACCESS_RW, ePAR_ROLE_ALL, ePAR_ROLE_ALL , 1, "Persistent byte object")
PAR_ITEM_ARR_U8 (ePAR_TEST_ARR_U8     , 11U , "Array U8"   , 3U       , 3U         , ((par_obj_init_t){ .p_data = (const uint8_t[]){ 1U, 2U, 3U }, .len = 3U })                  , NULL   , ePAR_ACCESS_RW, ePAR_ROLE_ALL, ePAR_ROLE_ALL , 0, "U8 array object")
PAR_ITEM_ARR_U16(ePAR_TEST_ARR_U16    , 12U , "Array U16"  , 2U       , 2U         , ((par_obj_init_t){ .p_data = (const uint8_t *)(const uint16_t[]){ 100U, 200U }, .len = (uint16_t)(2U * sizeof(uint16_t)) }), NULL, ePAR_ACCESS_RW, ePAR_ROLE_ALL, ePAR_ROLE_ALL, 0, "U16 array object")
PAR_ITEM_ARR_U32(ePAR_TEST_ARR_U32    , 13U , "Array U32"  , 2U       , 2U         , ((par_obj_init_t){ .p_data = (const uint8_t *)(const uint32_t[]){ 1000UL, 2000UL }, .len = (uint16_t)(2U * sizeof(uint32_t)) }), NULL, ePAR_ACCESS_RW, ePAR_ROLE_ALL, ePAR_ROLE_ALL, 0, "U32 array object")
